# Copy to .env and fill in:  cp env.example .env

# --- Azure GenAI Lab (OpenAI-compatible gateway) ---
LLM_PROVIDER=openai_compatible          # or "azure" for a native Azure OpenAI resource
GENAI_BASE_URL=https://genailab.tcs.in  # your GenAI Lab / Azure endpoint
GENAI_API_KEY=
GENAI_CHAT_MODEL=azure/genailab-maas-gpt-4o-mini
GENAI_EMBED_MODEL=azure/genailab-maas-text-embedding-3-large
GENAI_VERIFY_SSL=true                   # set false only if your corporate proxy breaks TLS verification
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Detection / retrieval ---
SPACY_MODEL=en_core_web_lg
USE_CROSS_ENCODER=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_DIR=                             # empty = in-memory vector store (policies only, never documents)
LLM_MAX_CHARS_PER_CALL=12000
LLM_MAX_CALLS_PER_DOC=8

# --- Audit ---
AUDIT_LOG=logs/audit.jsonl
AUDIT_HMAC_KEY=                         # set a stable secret so fingerprints are comparable across runs

# --- Microsoft 365 (optional, app-only Graph access with Files.ReadWrite.All) ---
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
